# viralme.live — paste into Vercel Environment Variables
# Every value must be non-empty. Prefer deleting unused keys over empty values.
# URLs MUST start with https://
# Do NOT use NEXT_PUBLIC_ for APP_URL — keep it server-only (Vercel "Config").

DEMO_AUTH=true
PAYMENT_PROVIDER=mock
AUTH_SECRET=change-me-to-a-long-random-string-32chars
DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/viralme?schema=public

# Server-only site URL (rename from NEXT_PUBLIC_APP_URL if Vercel warns)
APP_URL=https://viralme-live.vercel.app
AUTH_URL=https://viralme-live.vercel.app
NEXTAUTH_URL=https://viralme-live.vercel.app

NEXT_PUBLIC_APP_NAME=viralme.live
NEXT_PUBLIC_APP_DOMAIN=viralme.live
NEXT_PUBLIC_APP_CURRENCY=INR
NEXT_PUBLIC_SUPPORT_EMAIL=hello@viralme.live

EMAIL_PROVIDER=console
EMAIL_FROM=noreply@viralme.live
