# viralme.live Environment

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/viralme?schema=public"

AUTH_SECRET="change-me"
AUTH_URL="https://viralme.live"
NEXTAUTH_URL="https://viralme.live"
DEMO_AUTH="false"

NEXT_PUBLIC_APP_URL="https://viralme.live"
NEXT_PUBLIC_APP_NAME="viralme.live"
NEXT_PUBLIC_APP_DOMAIN="viralme.live"
NEXT_PUBLIC_APP_CURRENCY="INR"
NEXT_PUBLIC_SUPPORT_EMAIL="hello@viralme.live"

# India/Asia payments — Razorpay recommended
PAYMENT_PROVIDER="razorpay"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

EMAIL_PROVIDER="console"
EMAIL_FROM="noreply@viralme.live"

ENABLE_PAID_PROMOTIONS="true"
