# viralme.live Environment

# Required for lasting click/country analytics on Vercel (Neon / Supabase / Vercel Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/viralme?schema=public"

AUTH_SECRET="change-me-use-openssl-rand-base64-32"
AUTH_URL="https://your-app.vercel.app"
NEXTAUTH_URL="https://your-app.vercel.app"

# true = demo login + in-memory store (fine for UI preview; analytics reset on cold start)
# false = real DB + real auth required
DEMO_AUTH="true"

NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
NEXT_PUBLIC_APP_NAME="viralme.live"
NEXT_PUBLIC_APP_DOMAIN="viralme.live"
NEXT_PUBLIC_APP_CURRENCY="INR"
NEXT_PUBLIC_SUPPORT_EMAIL="hello@viralme.live"

# mock until Razorpay is wired
PAYMENT_PROVIDER="mock"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

EMAIL_PROVIDER="console"
EMAIL_FROM="noreply@viralme.live"

ENABLE_PAID_PROMOTIONS="true"
